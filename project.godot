[gd_resource type="ProjectSettings" format=3]

config_version = 5

[application]

config/name="Godot Windows Mobile"
config/description="A Windows simulator for Godot Engine mobile with games, wallpapers, taskbar, CMD and more"
config/version="1.0.0"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"

[debug]

gdscript/warnings/unused_variable=1
gdscript/warnings/unused_argument=1
gdscript/warnings/unreachable_code=1
gdscript/warnings/shadowed_variable=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"
window/handheld_mode=true

