[physics]

physics_engine/rigidbody_physics="GodotPhysics3D"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
global_illumination/gi_version=2
environment/ssao_enabled=false
environment/screen_space_ambient_occlusion_enabled=false
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/point_light_shadow/soft_shadow_filter_quality=2
lights_and_shadows/spot_light_shadow/soft_shadow_filter_quality=2
quality/shadows/directional_shadow/soft_shadow_filter_quality=2
quality/shadows/point_light_shadow/soft_shadow_filter_quality=2
quality/shadows/spot_light_shadow/soft_shadow_filter_quality=2
general/vram_compression=true

[window]

size/viewport_width=1280
size/viewport_height=720
stretch/mode="canvas_items"
handheld_mode=true
